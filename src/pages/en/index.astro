---
import Base from "../../layouts/Base.astro";
import HomeCover from "../../components/HomeCover.astro";
import { t } from "../../i18n";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Lumen Arkhé",
  url: "https://lumenarkhe.com/en",
  description: t("meta.desc_home", "en"),
  publisher: {
    "@type": "Organization",
    name: "Lumen Arkhé",
    url: "https://lumenarkhe.com",
  },
  inLanguage: "en",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://lumenarkhe.com/en/articulos?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
});
---

<Base title="Lumen Arkhé" description={t("meta.desc_home", "en")}>
  <script type="application/ld+json" set:html={jsonLd} />
  <HomeCover />
</Base>
